DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shambhu_news?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@shambhunews.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Media provider: use cloudinary for local testing, s3 for production.
MEDIA_PROVIDER="cloudinary"
NEXT_PUBLIC_MEDIA_PROVIDER="cloudinary"

# Cloudinary (local/testing)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AWS S3 (production)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="shambhu-news-media"
S3_PUBLIC_BASE_URL="https://YOUR_BUCKET.s3.ap-south-1.amazonaws.com"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
